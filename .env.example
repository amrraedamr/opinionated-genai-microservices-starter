# Copy to `.env` and fill in what you need. Everything has a safe default in
# Settings — only set the vars for the integrations you actually use.

# App
ENVIRONMENT=local
APP_NAME=opinionated-genai-starter
MAX_GUNICORN_WORKERS=2

# Auth (JWT RS256)
AUTH_PRIVATE_KEY_PATH=keys/private.pem
AUTH_PUBLIC_KEY_PATH=keys/public.pem
ACCESS_TOKEN_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_SECONDS=604800

# SQL (sqlite | mysql | postgresql)
SQL_BACKEND=sqlite
SQLITE_DB_PATH=database/app.db
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=3600
# DB_SSL_ENABLED=true

# PostgreSQL (when SQL_BACKEND=postgresql)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=app
# PG_SSL_ROOT_CERT=
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# MySQL (when SQL_BACKEND=mysql)
# MYSQL_HOST=localhost
# MYSQL_DATABASE=app
# MYSQL_USER=
# MYSQL_PASSWORD=

# Redis
# REDIS_URL=redis://localhost:6379/0
# REDIS_SSL_CERT_REQS=
# REDIS_MAX_CONNECTIONS=50
# REDIS_SOCKET_TIMEOUT=5.0
# REDIS_SOCKET_CONNECT_TIMEOUT=5.0
# REDIS_RETRY_ON_TIMEOUT=true
# REDIS_HEALTH_CHECK_INTERVAL=30
# REDIS_DECODE_RESPONSES=true

# Cosmos DB
# AZURE_COSMOS_ACCOUNT_URI=
# AZURE_COSMOS_ACCOUNT_KEY=
# AZURE_COSMOS_DATABASE_NAME=

# MongoDB
# MONGODB_USER=
# MONGODB_PASSWORD=
# MONGODB_BASE_PATH=mongodb
# MONGODB_HOST=localhost
# MONGODB_DATABASE=
# MONGODB_PARAMS=
# MONGODB_MIN_POOL_SIZE=5
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_CONNECT_TIMEOUT_MS=10000
# MONGODB_SOCKET_TIMEOUT_MS=30000
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000

# Azure Blob
# AZURE_BLOB_ACCOUNT_URL=

# Azure Key Vault (optional runtime secrets API — not a Settings source; see Settings docstring)
# KEYVAULT_URL=
# SYSTEM_KEYVAULT_TAG=appconfig
# MODEL_KEYVAULT_TAG=modelconfig

# Azure OpenAI LLM
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_LLM_ENDPOINT=
# AZURE_OPENAI_LLM_DEPLOYMENT_NAME=
# AZURE_OPENAI_LLM_API_KEY=

# Azure OpenAI Embeddings
# AZURE_OPENAI_EMBEDDING_ENDPOINT=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=
# AZURE_OPENAI_EMBEDDING_API_KEY=
# AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072
# AZURE_OPENAI_EMBEDDING_BATCH_SIZE=2048

# OpenAI LLM
# OPENAI_LLM_ENDPOINT=
# OPENAI_LLM_MODEL=
# OPENAI_LLM_API_KEY=

# OpenAI Embeddings
# OPENAI_EMBEDDING_ENDPOINT=
# OPENAI_EMBEDDING_MODEL=
# OPENAI_EMBEDDING_API_KEY=
# OPENAI_EMBEDDING_DIMENSIONS=1536
# OPENAI_EMBEDDING_BATCH_SIZE=2048

# Qdrant
# QDRANT_URL=
# QDRANT_GRPC_PORT=6334
# QDRANT_PREFER_GRPC=true
# QDRANT_TIMEOUT=30
# QDRANT_API_KEY=

# Azure AI Search
# AZURE_SEARCH_ENDPOINT=
# AZURE_SEARCH_VECTOR_FIELD=vector
# AZURE_SEARCH_KEY_FIELD=id
# AZURE_SEARCH_API_KEY=

# Prompts
LOAD_PROMPTS_FROM_DB=false
