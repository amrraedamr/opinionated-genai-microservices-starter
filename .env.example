# Auth - JWT with RSA256
AUTH_PRIVATE_KEY_PATH=<<path_to_your_private_key>>
AUTH_PUBLIC_KEY_PATH=<<path_to_your_public_key>>

# SQLite
SQLITE_DB_PATH=<<path_to_your_sqlite_db>>

# PostgreSQL
POSTGRES_USER=<<your_postgres_user>>
POSTGRES_PASSWORD=<<your_postgres_password>>

# MySQL
MYSQL_USER=<<your_mysql_user>>
MYSQL_PASSWORD=<<your_mysql_password>>

# Redis
REDIS_URL=<<your_redis_url>>

# Cosmos DB
AZURE_COSMOS_ACCOUNT_URI=<<your_cosmos_account_uri>>
AZURE_COSMOS_ACCOUNT_KEY=<<your_cosmos_account_key>>

# MongoDB
MONGODB_USER=<<your_mongodb_user>>
MONGODB_PASSWORD=<<your_mongodb_password>>

# Azure OpenAI LLM
AZURE_OPENAI_LLM_API_KEY=<<your_azure_openai_llm_key>>

# Azure OpenAI Embeddings
AZURE_OPENAI_EMBEDDING_API_KEY=<<your_azure_openai_embedding_api_key>>

# OpenAI LLM
OPENAI_LLM_API_KEY=<<your_openai_llm_api_key>>

# OpenAI Embeddings
OPENAI_EMBEDDING_API_KEY=<<your_openai_embedding_api_key>>

# Qdrant Vector Database
QDRANT_API_KEY=<<your_qdrant_api_key>>

# Azure AI Search
AZURE_SEARCH_API_KEY=<<your_azure_search_api_key>>
